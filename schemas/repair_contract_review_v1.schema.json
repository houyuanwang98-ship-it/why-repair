{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic contract review (judgments, not proof certificates)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "input_digest", "reviewer_id", "checks"],
  "properties": {
    "schema_version": {"const": "repair-contract-review-v1"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "reviewer_id": {"$ref": "#/$defs/text"},
    "checks": {"type": "array", "minItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "status", "reason", "source_refs"],
      "properties": {
        "check_id": {"$ref": "#/$defs/text"},
        "status": {"enum": ["accepted", "needs_revision", "undetermined"]},
        "reason": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false, "required": ["source_id", "digest"],
          "properties": {"source_id": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}
        }}
      }
    }}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
