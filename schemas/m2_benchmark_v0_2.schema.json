{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/why-repair/m2-benchmark-v0.2.schema.json",
  "title": "M2 benchmark artifact contract v0.2",
  "oneOf": [
    {"$ref": "#/$defs/SourceRow"},
    {"$ref": "#/$defs/AnnotationRow"},
    {"$ref": "#/$defs/DisagreementRow"},
    {"$ref": "#/$defs/AdjudicationRow"},
    {"$ref": "#/$defs/AgreementReport"},
    {"$ref": "#/$defs/GoldRow"},
    {"$ref": "#/$defs/GoldManifest"}
  ],
  "$defs": {
    "JsonScalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "ProofStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "text"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "SourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "proof_id", "theorem_version", "domain", "theorem", "assumptions", "proof_steps"],
      "properties": {
        "schema_version": {"const": "m2-source-0.1"},
        "proof_id": {"type": "string", "minLength": 1},
        "theorem_version": {"type": "integer", "minimum": 1},
        "domain": {"type": "string", "minLength": 1},
        "theorem": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "proof_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ProofStep"}}
      }
    },
    "AssumptionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption", "satisfied", "evidence"],
      "properties": {
        "assumption": {"type": "string", "minLength": 1},
        "satisfied": {"const": true},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "CounterexampleCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "claim_ref", "assignments", "assumption_checks", "target_false", "verification_method", "verification_notes"],
      "properties": {
        "scope": {"enum": ["local_node", "original_theorem"]},
        "claim_ref": {"type": "string", "minLength": 1},
        "assignments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/JsonScalar"}
        },
        "assumption_checks": {"type": "array", "items": {"$ref": "#/$defs/AssumptionCheck"}},
        "target_false": {"const": true},
        "verification_method": {"enum": ["manual_exact", "python", "sympy", "exhaustive"]},
        "verification_notes": {"type": "string", "minLength": 1}
      }
    },
    "AnnotationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sample_id", "annotator_id", "validity_status", "first_gap_step", "first_invalid_step", "error_type", "counterexample_status", "counterexample", "minimal_repair", "notes"],
      "properties": {
        "schema_version": {"const": "m2.2"},
        "sample_id": {"type": "string", "minLength": 1},
        "annotator_id": {"type": "string", "minLength": 1},
        "validity_status": {"enum": ["valid", "valid_with_gap", "invalid", "undetermined"]},
        "first_gap_step": {"type": ["integer", "null"], "minimum": 1},
        "first_invalid_step": {"type": ["integer", "null"], "minimum": 1},
        "error_type": {"enum": ["quantifier_error", "missing_assumption", "theorem_misuse", "algebraic_invalidity", "proof_gap", "target_shift", "false_generalization", "no_error", "undetermined"]},
        "counterexample_status": {"enum": ["not_applicable", "valid", "invalid", "undetermined"]},
        "counterexample": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/CounterexampleCertificate"}]},
        "minimal_repair": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"validity_status": {"const": "valid"}}}, "then": {"properties": {"error_type": {"const": "no_error"}, "first_gap_step": {"type": "null"}, "first_invalid_step": {"type": "null"}, "counterexample_status": {"const": "not_applicable"}, "counterexample": {"type": "null"}, "minimal_repair": {"type": "null"}}}},
        {"if": {"properties": {"validity_status": {"const": "valid_with_gap"}}}, "then": {"properties": {"error_type": {"const": "proof_gap"}, "first_gap_step": {"type": "integer", "minimum": 1}, "first_invalid_step": {"type": "null"}, "counterexample_status": {"const": "not_applicable"}, "counterexample": {"type": "null"}, "minimal_repair": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"validity_status": {"const": "invalid"}}}, "then": {"properties": {"first_invalid_step": {"type": "integer", "minimum": 1}, "error_type": {"not": {"enum": ["no_error", "proof_gap", "undetermined"]}}, "minimal_repair": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"validity_status": {"const": "undetermined"}}}, "then": {"properties": {"error_type": {"const": "undetermined"}, "first_gap_step": {"type": "null"}, "first_invalid_step": {"type": "null"}, "counterexample_status": {"const": "undetermined"}, "counterexample": {"type": "null"}, "minimal_repair": {"type": "null"}}}},
        {"if": {"properties": {"counterexample_status": {"const": "valid"}}}, "then": {"properties": {"counterexample": {"$ref": "#/$defs/CounterexampleCertificate"}}}},
        {"if": {"properties": {"counterexample_status": {"not": {"const": "valid"}}}}, "then": {"properties": {"counterexample": {"type": "null"}}}}
      ]
    },
    "DisagreementRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sample_id", "field", "person_a_value", "person_b_value"],
      "properties": {
        "schema_version": {"const": "m2.2"},
        "sample_id": {"type": "string", "minLength": 1},
        "field": {"enum": ["validity_status", "first_gap_step", "first_invalid_step", "error_type", "counterexample_status", "counterexample", "minimal_repair"]},
        "person_a_value": {},
        "person_b_value": {}
      }
    },
    "AdjudicationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sample_id", "field", "person_a_value", "person_b_value", "final_value", "disagreement_type", "evidence", "rationale", "adjudicators"],
      "properties": {
        "schema_version": {"const": "m2.2"},
        "sample_id": {"type": "string", "minLength": 1},
        "field": {"enum": ["validity_status", "first_gap_step", "first_invalid_step", "error_type", "counterexample_status", "counterexample", "minimal_repair"]},
        "person_a_value": {},
        "person_b_value": {},
        "final_value": {},
        "disagreement_type": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "adjudicators": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "AgreementReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sample_count", "person_a_annotator", "person_b_annotator", "fields", "disagreement_count", "inputs"],
      "properties": {
        "schema_version": {"const": "m2.2"},
        "sample_count": {"type": "integer", "minimum": 0},
        "person_a_annotator": {"type": "string", "minLength": 1},
        "person_b_annotator": {"type": "string", "minLength": 1},
        "fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
        "disagreement_count": {"type": "integer", "minimum": 0},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha256", "person_a_sha256", "person_b_sha256"],
          "properties": {
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "person_a_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "person_b_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "GoldRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "proof_id", "theorem_version", "domain", "theorem", "assumptions", "proof_steps", "gold_schema_version", "gold_validity_status", "gold_first_gap_step", "gold_first_invalid_step", "gold_error_type", "gold_counterexample_status", "gold_counterexample", "gold_minimal_repair"],
      "properties": {
        "schema_version": {"const": "m2-source-0.1"},
        "proof_id": {"type": "string", "minLength": 1},
        "theorem_version": {"type": "integer", "minimum": 1},
        "domain": {"type": "string", "minLength": 1},
        "theorem": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "proof_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ProofStep"}},
        "gold_schema_version": {"const": "m2.2"},
        "gold_validity_status": {"enum": ["valid", "valid_with_gap", "invalid", "undetermined"]},
        "gold_first_gap_step": {"type": ["integer", "null"], "minimum": 1},
        "gold_first_invalid_step": {"type": ["integer", "null"], "minimum": 1},
        "gold_error_type": {"enum": ["quantifier_error", "missing_assumption", "theorem_misuse", "algebraic_invalidity", "proof_gap", "target_shift", "false_generalization", "no_error", "undetermined"]},
        "gold_counterexample_status": {"enum": ["not_applicable", "valid", "invalid", "undetermined"]},
        "gold_counterexample": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/CounterexampleCertificate"}]},
        "gold_minimal_repair": {"type": ["string", "null"]}
      }
    },
    "GoldManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "contract_version", "generator", "row_count", "inputs", "output_sha256"],
      "properties": {
        "artifact_type": {"const": "m2_adjudicated_gold"},
        "contract_version": {"const": "m2.2"},
        "generator": {"const": "scripts/build_m2_gold.py"},
        "row_count": {"type": "integer", "minimum": 0},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha256", "person_a_sha256", "person_b_sha256", "adjudications_sha256"],
          "properties": {
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "person_a_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "person_b_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "adjudications_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
