{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local inference review v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_digest", "evaluator_id", "decision", "error_type", "rule", "conditions", "circularity", "conclusion", "bridge_steps", "reason"],
  "properties": {
    "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["accepted", "invalid", "gap", "undetermined"]},
    "error_type": {"enum": [null, "theorem_misuse", "algebraic_invalidity", "false_local_claim", "missing_assumption", "target_mismatch", "circular_reasoning"]},
    "rule": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition", "status", "source_refs", "justification"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "missing", "unknown"]},
          "source_refs": {"$ref": "#/$defs/sources"},
          "justification": {"type": "string", "minLength": 1}
        }
      }
    },
    "circularity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source_refs", "justification"],
      "properties": {
        "status": {"enum": ["clear", "circular", "unknown"]},
        "source_refs": {"$ref": "#/$defs/sources"},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "conclusion": {"$ref": "#/$defs/step"},
    "bridge_steps": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "sources": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "digest"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "source_refs", "justification"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/sources"},
        "justification": {"type": "string", "minLength": 1}
      }
    }
  }
}
