{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m5_provisional_summary_v0_2.schema.json",
  "title": "M5 provisional summary v0.2",
  "type": "object",
  "required": ["summary_version", "scope", "source_cases", "source_status_counts",
    "cases_requiring_m5_disposition", "human_case_decisions", "materialized_completion_files",
    "controller_outcomes", "unchanged_valid_cases_without_patch", "completion_set_sha256",
    "deterministic_rerun", "json_parse_check", "m5_specialized_tests", "full_regression",
    "evidence_limitations", "formal_real_pilot_gate", "m6_entry_allowed"],
  "properties": {
    "summary_version": {"const": "m5-provisional-summary-0.2"},
    "scope": {"const": "api_free_interactive_engineering_and_conversation_review_evidence"},
    "source_cases": {"const": 50},
    "source_status_counts": {"type": "object"},
    "cases_requiring_m5_disposition": {"const": 36},
    "human_case_decisions": {"const": 36},
    "materialized_completion_files": {"const": 36},
    "controller_outcomes": {"type": "object"},
    "unchanged_valid_cases_without_patch": {"const": 14},
    "completion_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deterministic_rerun": {"const": "passed"},
    "json_parse_check": {"const": "passed"},
    "m5_specialized_tests": {"type": "object"},
    "full_regression": {"type": "object"},
    "evidence_limitations": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "formal_real_pilot_gate": {"const": "blocked_missing_api_provenance_and_provider_records"},
    "m6_entry_allowed": {"const": false}
  }
}
