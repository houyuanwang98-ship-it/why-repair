{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "m5_person_b_run_manifest_v0_1.schema.json",
  "title": "M5 Person B replay manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "release", "run_id", "proof_id", "input_digest", "m4_input_digest", "attempt_fingerprints", "model_invocations", "metrics", "events", "final_state_digest", "stop_reason"],
  "properties": {"schema_version": {"const": "0.1"}, "release": {"const": "m5-person-b-v0.1"}, "run_id": {"type": "string", "minLength": 1}, "proof_id": {"type": "string", "minLength": 1}, "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "m4_input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "attempt_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "model_invocations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["invocation_id", "model", "prompt_version", "status", "token_usage", "latency_ms", "error_type"], "properties": {"invocation_id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "prompt_version": {"type": "string", "minLength": 1}, "status": {"enum": ["completed", "failed"]}, "token_usage": {"$ref": "#/$defs/tokenUsage"}, "latency_ms": {"type": "integer", "minimum": 0}, "error_type": {"type": ["string", "null"]}}}}, "metrics": {"type": "object", "additionalProperties": false, "required": ["model_calls", "failed_model_calls", "token_usage", "total_latency_ms"], "properties": {"model_calls": {"type": "integer", "minimum": 0}, "failed_model_calls": {"type": "integer", "minimum": 0}, "token_usage": {"$ref": "#/$defs/tokenUsage"}, "total_latency_ms": {"type": "integer", "minimum": 0}}}, "events": {"type": "array", "items": {"type": "object"}}, "final_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "stop_reason": {"oneOf": [{"enum": ["accepted", "revalidation_failed", "irreparable", "equivalent_patch", "max_rounds"]}, {"type": "null"}]}},
  "$defs": {"tokenUsage": {"type": "object", "additionalProperties": false, "required": ["input", "output"], "properties": {"input": {"type": "integer", "minimum": 0}, "output": {"type": "integer", "minimum": 0}}}}
}
