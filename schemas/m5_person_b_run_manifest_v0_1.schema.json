{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "m5_person_b_run_manifest_v0_1.schema.json",
  "title": "M5 Person B replay manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "release", "run_id", "proof_id", "input_digest", "m4_input_digest", "attempt_fingerprints", "events", "final_state_digest", "stop_reason"],
  "properties": {"schema_version": {"const": "0.1"}, "release": {"const": "m5-person-b-v0.1"}, "run_id": {"type": "string", "minLength": 1}, "proof_id": {"type": "string", "minLength": 1}, "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "m4_input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "attempt_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "events": {"type": "array", "items": {"type": "object"}}, "final_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "stop_reason": {"oneOf": [{"enum": ["accepted", "irreparable", "equivalent_patch", "max_rounds"]}, {"type": "null"}]}}
}
