{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4 Person A Counterexample Review v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version", "reviewer_id", "verifier_id", "certificate_id",
    "scope", "claimed_error_type", "verification_status",
    "verification_method", "accepted", "decision", "reasons",
    "verification_notes", "review_context_digest"
  ],
  "properties": {
    "profile_version": {"const": "m4-counterexample-person-a-v0.2"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "certificate_id": {"type": ["string", "null"]},
    "scope": {"enum": ["local_claim", "global_theorem", null]},
    "claimed_error_type": {"enum": ["false_local_claim", "false_theorem", null]},
    "verification_status": {"enum": ["verified", "failed", "undetermined"]},
    "verification_method": {"enum": ["manual_exact", "executable_exact", "hybrid_exact"]},
    "accepted": {"type": "boolean"},
    "decision": {"enum": ["accepted", "rejected", "undetermined"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_notes": {"type": "string", "minLength": 1},
    "review_context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"accepted": {"const": true}}, "required": ["accepted"]},
      "then": {
        "properties": {
          "decision": {"const": "accepted"},
          "verification_status": {"const": "verified"},
          "certificate_id": {"type": "string"},
          "scope": {"enum": ["local_claim", "global_theorem"]},
          "reasons": {"maxItems": 0}
        }
      }
    }
  ]
}
