{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1 Role-by-Role Revalidation",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "validation_date", "wire_contract_version", "release", "engineering_exit", "records"],
  "properties": {
    "schema_version": {"const": "m1-role-revalidation-1.0"}, "validation_date": {"type": "string", "format": "date"},
    "wire_contract_version": {"const": "0.3"}, "release": {"const": "v0.3.1"},
    "engineering_exit": {"const": "pass_with_declared_human_review_limitation"},
    "records": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["validation_id", "target", "owner", "reviewer", "method", "inputs", "result", "evidence", "limitations", "timestamp"],
      "properties": {
        "validation_id": {"type": "string", "pattern": "^M1-RV-[A-Z]+-[0-9]{3}$"},
        "target": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "result": {"enum": ["pass", "pass_with_limitation", "fail", "needs_revision", "undetermined", "not_applicable"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
