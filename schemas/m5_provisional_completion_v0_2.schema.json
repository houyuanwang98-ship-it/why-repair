{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m5_provisional_completion_v0_2.schema.json",
  "title": "M5 provisional batch completion v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "proof_id", "run_id", "batch_id", "repair_rounds",
    "revalidation_evaluation_ids", "revalidation_verdicts", "controller_stop_reason",
    "final_state_digest", "replayed_manifest_digest", "certificate_digests",
    "formal_real_pilot_gate", "person_a_identity_evidence"],
  "properties": {
    "record_version": {"const": "m5-provisional-completion-0.2"},
    "proof_id": {"type": "string", "pattern": "^m2-[0-9]{3}$"},
    "run_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "repair_rounds": {"type": "integer", "minimum": 1, "maximum": 4},
    "revalidation_evaluation_ids": {"type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}},
    "revalidation_verdicts": {"type": "array", "items": {"enum": ["accepted", "rejected", "undetermined"]}},
    "controller_stop_reason": {"enum": ["accepted", "irreparable"]},
    "final_state_digest": {"$ref": "#/$defs/digest"},
    "replayed_manifest_digest": {"$ref": "#/$defs/digest"},
    "certificate_digests": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}},
    "formal_real_pilot_gate": {"const": "blocked_missing_api_provenance_and_provider_records"},
    "person_a_identity_evidence": {"const": "conversation_batch_attestation_only"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
