{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M3 Person A / Person B Joint Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release", "status", "accepted_at", "review_mode",
    "contract_sha256", "frozen_manifest_sha256", "reviewers",
    "audited_disagreements", "known_limitations"
  ],
  "properties": {
    "schema_version": {"const": "m3-joint-acceptance-1.0"},
    "release": {"const": "m3-evaluator-v1.0"},
    "status": {"const": "accepted_by_person_a_and_person_b"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "review_mode": {"const": "post_freeze_non_blind"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "decision", "evidence", "evidence_sha256"],
        "properties": {
          "reviewer_id": {"enum": ["person_a", "person_b"]},
          "decision": {"const": "pass_with_known_limitation"},
          "evidence": {"type": "string", "minLength": 1},
          "evidence_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "audited_disagreements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_validity", "error_type", "first_invalid", "first_gap"],
      "properties": {
        "proof_validity": {"$ref": "#/$defs/sampleIds"},
        "error_type": {"$ref": "#/$defs/sampleIds"},
        "first_invalid": {"$ref": "#/$defs/sampleIds"},
        "first_gap": {"$ref": "#/$defs/sampleIds"}
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "kind", "disposition"],
        "properties": {
          "sample_id": {"pattern": "^m2-[0-9]{3}$"},
          "kind": {"const": "gold_label_error"},
          "disposition": {"const": "preserve_in_v1_correct_in_future_benchmark_version"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sampleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^m2-[0-9]{3}$"}
    }
  }
}
