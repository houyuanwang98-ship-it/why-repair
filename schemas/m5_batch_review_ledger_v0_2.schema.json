{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m5_batch_review_ledger_v0_2.schema.json",
  "title": "M5 conversation batch review ledger v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_version", "evidence_strength", "reviewer_id", "identity_verified",
    "cryptographic_signature_present", "accepted_batches", "rejected_batches",
    "human_case_decisions_complete", "materialized_completion_files_at_freeze",
    "pending_per_case_materialization", "formal_real_pilot_gate"],
  "properties": {
    "ledger_version": {"const": "m5-provisional-batch-review-0.2"},
    "evidence_strength": {"const": "explicit_user_decisions_in_active_conversation"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "identity_verified": {"const": false},
    "cryptographic_signature_present": {"const": false},
    "accepted_batches": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "rejected_batches": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "human_case_decisions_complete": {"const": 36},
    "materialized_completion_files_at_freeze": {"const": 36},
    "pending_per_case_materialization": {"type": "array", "maxItems": 0},
    "formal_real_pilot_gate": {"const": "blocked_missing_api_provenance_and_provider_records"}
  }
}
