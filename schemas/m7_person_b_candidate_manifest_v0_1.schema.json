{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m7_person_b_candidate_manifest_v0_1.schema.json",
  "title": "M7 Person B fixture-only engineering candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_version", "status", "artifacts", "upstream", "capabilities", "pending", "m7_execution_allowed"],
  "properties": {
    "schema_version": {"const": "m7-person-b-candidate-manifest-0.1"},
    "candidate_version": {"const": "m7-person-b-v0.1"},
    "status": {"const": "engineering_candidate_ready_fixture_only_execution_blocked"},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["docs/milestones/M07_person_b_benchmark_integrity_and_experiment_execution.md", "harness/m7_person_b.py"],
      "properties": {
        "docs/milestones/M07_person_b_benchmark_integrity_and_experiment_execution.md": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "harness/m7_person_b.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["person_a_manifest_path", "person_a_manifest_sha256", "m7_entry_allowed"],
      "properties": {
        "person_a_manifest_path": {"const": "data/benchmarks/m7/person_a_protocol_candidate_v0_1.json"},
        "person_a_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "m7_entry_allowed": {"const": false}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_schema_fixture", "dedup_leakage_fixture", "run_matrix_fixture", "terminal_ledger_fixture"],
      "properties": {
        "candidate_schema_fixture": {"const": true}, "dedup_leakage_fixture": {"const": true},
        "run_matrix_fixture": {"const": true}, "terminal_ledger_fixture": {"const": true}
      }
    },
    "pending": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "m7_execution_allowed": {"const": false}
  }
}
