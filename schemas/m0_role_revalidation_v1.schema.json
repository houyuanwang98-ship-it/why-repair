{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M0 Role-by-Role Revalidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_date", "engineering_exit", "strict_research_evidence_exit", "records", "requirement_results", "limitations"],
  "properties": {
    "schema_version": {"const": "m0-role-revalidation-1.1"},
    "validation_date": {"type": "string", "format": "date"},
    "engineering_exit": {"const": "pass_with_declared_limitation"},
    "strict_research_evidence_exit": {"const": "fail"},
    "records": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/validation_record"}},
    "requirement_results": {"type": "object", "minProperties": 12, "additionalProperties": {"enum": ["pass", "pass_with_limitation", "fail", "needs_revision", "undetermined", "not_applicable"]}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "validation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "target", "owner", "reviewer", "method", "inputs", "result", "evidence", "limitations", "timestamp"],
      "properties": {
        "validation_id": {"type": "string", "pattern": "^M0-RV-[A-Z]+-[0-9]{3}$"},
        "target": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "result": {"enum": ["pass", "pass_with_limitation", "fail", "needs_revision", "undetermined", "not_applicable"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
