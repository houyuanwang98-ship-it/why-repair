{
  "proof_id": "alg_001",
  "theorem": "Let V be a finite-dimensional vector space and let T: V -> V be linear. If T is injective, then T is surjective.",
  "assumptions": [
    "V is finite-dimensional",
    "T: V -> V is linear",
    "T is injective"
  ],
  "domain": "algebra",
  "nodes": [
    {
      "proof_id": "alg_001",
      "node_id": 1,
      "version": 1,
      "order_key": 10,
      "claim": "Since T is injective, ker(T) = {0}.",
      "self_contained_claim": "Since T is injective, ker(T) = {0}.",
      "node_type": "inference",
      "depends_on": []
    },
    {
      "proof_id": "alg_001",
      "node_id": 2,
      "version": 1,
      "order_key": 20,
      "claim": "Therefore dim im(T) = dim V.",
      "self_contained_claim": "Therefore dim im(T) = dim V.",
