        "item": {
          "clientId": null,
          "content": [
            {
              "text": "{\"problem\": {\"theorem\": \"Let $f$ be a continuous real function on a metric space $X$. Let $Z(f)$ (the zero set of $f$ ) be the set of all $p \\\\in X$ at which $f(p)=0$. Prove that $Z(f)$ is closed.\", \"assumptions\": [], \"domain\": \"real_analysis\", \"explicit_subgoals\": []}, \"candidate_text\": \"Since \\\\(f:X\\\\to\\\\mathbb R\\\\) is continuous and \\\\(\\\\{0\\\\}\\\\) is closed in \\\\(\\\\mathbb R\\\\), its inverse image under \\\\(f\\\\) is closed in \\\\(X\\\\). But\\n\\\\[\\nZ(f)=\\\\{p\\\\in X:f(p)=0\\\\}=f^{-1}(\\\\{0\\\\}).\\n\\\\]\\nTherefore \\\\(Z(f)\\\\) is closed.\"}",
              "text_elements": [],
              "type": "text"
            }
          ],
