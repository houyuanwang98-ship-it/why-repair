      "method": "item/started",
      "params": {
        "item": {
          "clientId": null,
          "content": [
            {
              "text": "{\"problem\": {\"theorem\": \"证明两个奇整数之和为偶数。\", \"assumptions\": [\"a,b 为奇整数。\"], \"domain\": \"elementary_algebra\", \"explicit_subgoals\": []}, \"candidates\": [{\"candidate_id\": \"choice-1\", \"text\": \"由 a,b 为奇整数，存在整数 m,n，使得 a=2m+1，b=2n+1。因此\\na+b=(2m+1)+(2n+1)=2(m+n+1)。\\n因为 m+n+1 是整数，所以 a+b 能表示为 2 与某个整数的乘积，故 a+b 为偶数。\"}, {\"candidate_id\": \"choice-2\", \"text\": \"设任意整数 a,b 均为奇数。则存在整数 m,n，使得 a=2m+1，b=2n+1。因此 a+b=2m+1+2n+1=2(m+n+1)。由于 m+n+1 为整数，故 a+b 为偶数。由 a,b 的任意性，任意两个奇数之和均为偶数。\"}, {\"candidate_id\": \"choice-3\", \"text\": \"设 a,b 为奇整数。根据奇整数的定义，存在整数 m,n，使得 a=2m+1，b=2n+1。因此\\na+b=(2m+1)+(2n+1)=2(m+n+1)。\\n由于 m+n+1 是整数，故 a+b 能被 2 整除，所以 a+b 是偶数。\"}]}",
              "text_elements": [],
              "type": "text"
            }
          ],
