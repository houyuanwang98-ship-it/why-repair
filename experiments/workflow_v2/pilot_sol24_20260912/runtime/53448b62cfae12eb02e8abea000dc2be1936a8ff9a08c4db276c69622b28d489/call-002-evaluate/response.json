        "item": {
          "clientId": null,
          "content": [
            {
              "text": "{\"problem\": {\"theorem\": \"Prove that any two nonabelian groups of order 21 are isomorphic.\", \"assumptions\": [], \"domain\": \"abstract_algebra\", \"explicit_subgoals\": []}, \"target\": {\"node_id\": \"n1\", \"version\": 1}, \"target_node\": {\"text\": \"\\\\begin{proof}\\n\\n    By Cauchy's theorem we have that if $G$ is a group of order 21 then it has an element $a$ of order 3 and an element $b$ of order 7.\", \"claim\": \"Cauchy's theorem supplies elements of orders 3 and 7 because both primes divide 21.\", \"scope\": [], \"depends_on\": []}, \"closed_predecessors\": [], \"counterexample_search\": true, \"rule_candidates\": [{\"id\": \"grp_first_iso\", \"name\": \"First isomorphism theorem for groups\", \"statement\": \"If phi: G -> H is a group homomorphism, then G/ker(phi) is isomorphic to im(phi).\", \"conditions\": [\"phi is a group homomorphism\", \"ker(phi) is the kernel of phi\"], \"conclusion\": \"G/ker(phi) is isomorphic to im(phi).\", \"rule_digest\": \"335c687d26f64e41584f1b8bc575aec9d78223b01c4821bf0056bf8533de0c19\", \"applicability\": \"unchecked\"}, {\"id\": \"ring_quotient_ideal\", \"name\": \"Quotient ring criterion\", \"statement\": \"If I is a two-sided ideal of a ring R, then R/I is a quotient ring with operations defined on cosets.\", \"conditions\": [\"I is a two-sided ideal of R\"], \"conclusion\": \"R/I is a ring and coset operations are well-defined.\", \"rule_digest\": \"5c419f063bbc02eba57c0943d5ecce5f2e4c1b370cbb5ad6d69c2e08c3b21835\", \"applicability\": \"unchecked\"}, {\"id\": \"grp_lagrange\", \"name\": \"Lagrange theorem\", \"statement\": \"If G is a finite group and H is a subgroup of G, then |H| divides |G|.\", \"conditions\": [\"G is finite\", \"H is a subgroup of G\"], \"conclusion\": \"|H| divides |G|.\", \"rule_digest\": \"361a6b53eb7c1cb71cc90836aab9022d76163052528c559907341ebabe9bf547\", \"applicability\": \"unchecked\"}]}",
              "text_elements": [],
              "type": "text"
            }
