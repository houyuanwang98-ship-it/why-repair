            {
              "text": "{\"problem\": {\"theorem\": \"Consider a prime $p$ of the form $4 t+3$. Show that $a$ is a primitive root modulo $p$ iff $-a$ has order $(p-1) / 2$.\", \"assumptions\": [], \"domain\": \"number_theory\", \"explicit_subgoals\": []}, \"target\": {\"node_id\": \"n1\", \"version\": 1}, \"target_node\": {\"text\": \"\\\\begin{proof}\\n\\n    Let $a$ a primitive root modulo $p$.\", \"claim\": \"For the forward implication, assume that $a$ is a primitive root modulo $p$.\", \"scope\": [], \"depends_on\": [], \"goal_refs\": []}, \"closed_predecessors\": [], \"counterexample_search\": true, \"rule_candidates\": [{\"id\": \"grp_first_iso\", \"name\": \"First isomorphism theorem for groups\", \"statement\": \"If phi: G -> H is a group homomorphism, then G/ker(phi) is isomorphic to im(phi).\", \"conditions\": [\"phi is a group homomorphism\", \"ker(phi) is the kernel of phi\"], \"conclusion\": \"G/ker(phi) is isomorphic to im(phi).\", \"rule_digest\": \"335c687d26f64e41584f1b8bc575aec9d78223b01c4821bf0056bf8533de0c19\", \"applicability\": \"unchecked\"}, {\"id\": \"grp_normal_quotient\", \"name\": \"Quotient group criterion\", \"statement\": \"If N is a normal subgroup of G, then the set of left cosets G/N forms a group under (aN)(bN) = abN.\", \"conditions\": [\"N is a subgroup of G\", \"N is normal in G\"], \"conclusion\": \"G/N is a group and coset multiplication is well-defined.\", \"rule_digest\": \"f6d458aa2e7463efeea7a535cdbe0f0f7930259cfe7f845b5350ec03454da876\", \"applicability\": \"unchecked\"}, {\"id\": \"grp_subgroup_test\", \"name\": \"Subgroup test\", \"statement\": \"A nonempty subset H of a group G is a subgroup if for all a,b in H, ab^{-1} is in H.\", \"conditions\": [\"H is nonempty\", \"H is a subset of G\", \"G is a group\"], \"conclusion\": \"H is a subgroup of G.\", \"rule_digest\": \"ba2e60e3c051f1e20706af088d5f217ae14581272220bfc9f34a7f86eea0d4e8\", \"applicability\": \"unchecked\"}]}",
              "text_elements": [],
